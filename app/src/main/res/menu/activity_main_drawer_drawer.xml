<?xml version="1.0" encoding="utf-8"?>
<!-- Menú lateral. AniList e Historial pasaron a la pantalla de Perfil (barra inferior): quedan ocultos
     para no romper el código que los busca por id. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:tools="http://schemas.android.com/tools"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      tools:showIn="navigation_view">

    <!-- Explorar: todo se movió (Explorador -> Perfil/Descargas, Emisión -> barra inferior; Sugerencias, Random y Pendientes se quitaron) -->
    <item android:title="Explorar" android:visible="false">
        <menu>
            <item
                android:id="@+id/drawer_explorer"
                android:visible="false"
                android:icon="@drawable/ic_files"
                android:title="Explorador"/>
            <item
                android:id="@+id/drawer_emision"
                android:visible="false"
                android:icon="@drawable/ic_emision"
                android:title="Emisión"
                app:actionViewClass="android.widget.TextView"/>
            <item
                android:id="@+id/drawer_seeing"
                android:icon="@drawable/ic_seeing_drawer"
                android:visible="false"
                android:title="Siguiendo"
                app:actionViewClass="android.widget.TextView"/>
            <item
                android:id="@+id/drawer_queue"
                android:visible="false"
                android:icon="@drawable/ic_clock"
                android:title="Pendientes"
                app:actionViewClass="android.widget.TextView"/>
            <item
                android:id="@+id/drawer_suggestions"
                android:visible="false"
                android:icon="@drawable/ic_suggestions"
                android:title="Sugerencias"/>
            <item
                android:id="@+id/drawer_news"
                android:icon="@drawable/ic_news"
                android:visible="false"
                android:title="Noticias"/>
            <item
                android:id="@+id/drawer_random"
                android:visible="false"
                android:icon="@drawable/ic_random"
                android:title="Random"/>
        </menu>
    </item>

    <item android:title="AniList">
        <menu>
            <item
                android:id="@+id/drawer_anilist_stats"
                android:icon="@drawable/ic_drawer_stats"
                android:title="@string/anilist_tab_stats"/>
            <item
                android:id="@+id/drawer_anilist_profile"
                android:icon="@drawable/ic_drawer_profile"
                android:title="@string/anilist_tab_profile"/>
            <item
                android:id="@+id/drawer_anilist_exceptions"
                android:icon="@drawable/ic_anilist_pending"
                android:title="@string/anilist_exceptions_title"
                android:visible="false"
                app:actionViewClass="android.widget.TextView"/>
            <item
                android:id="@+id/drawer_faq"
                android:icon="@drawable/ic_faq"
                android:visible="false"
                android:title="FAQ" />
            <!-- Movidos a Perfil -->
            <item
                android:id="@+id/drawer_anilist"
                android:icon="@drawable/ic_anilist_synced"
                android:visible="false"
                android:title="AniList"/>
            <item
                android:id="@+id/drawer_records"
                android:icon="@drawable/ic_record"
                android:visible="false"
                android:title="Historial"/>
        </menu>
    </item>
</menu>
